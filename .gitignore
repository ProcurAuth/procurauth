# Build output stays in a Docker volume, but a local build can write here.
/target/

# Local files.
.env
.env.*
*.pem
*.swp
.DS_Store

# The test keys of access-token are public on purpose: they sign nothing real.
!/crates/access-token/examples/*.pem
!/crates/access-conformance/examples/*.pem
# The TLS test CA, certificate and key of procurauth-pep are public on purpose: they protect nothing.
!/crates/procurauth-pep/tests/data/tls-test-*.pem

# Python caches.
__pycache__/
