{
  "id": "U122",
  "title": "A submission that gets explanation_required or cannot_supersede gives the tool error invalid_argument, and the action does not run.",
  "role": "pep",
  "paragraphs": [
    "mcp:5.7a",
    "17.4"
  ],
  "requirement": "MUST",
  "skip_if": [
    "no_mcp_endpoint"
  ],
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      }
    },
    "pdp_script": [
      {
        "when": {
          "action": "{{other_action}}",
          "usage": false,
          "no_effect": true
        },
        "respond": {
          "body": {
            "decision": true
          }
        }
      },
      {
        "when": {
          "no_effect": true
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "approval_required"
            }
          }
        }
      },
      {
        "when": {
          "usage": false
        },
        "respond": {
          "body": {
            "decision": false,
            "context": {
              "reason": "approval_required",
              "evaluation_id": "ev_conformance_1"
            }
          }
        }
      }
    ],
    "approval_script": [
      {
        "when": {
          "route": "submit"
        },
        "times": 1,
        "respond": {
          "status": 422,
          "body": {
            "error": "explanation_required"
          }
        }
      },
      {
        "when": {
          "route": "submit"
        },
        "times": 1,
        "respond": {
          "status": 409,
          "body": {
            "error": "cannot_supersede"
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "The PDP needs the explanation of the agent",
      "request": {
        "operation": "mcp_call_approval",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/result/isError": {
            "equals": true
          },
          "/result/structuredContent/error/code": {
            "equals": "invalid_argument"
          },
          "/result/structuredContent/error/retryable": {
            "equals": false
          }
        },
        "pdp_questions": [
          {
            "json": {
              "/context/usage": {
                "present": true
              },
              "/context/approval/effect": {
                "present": true
              }
            },
            "count": {
              "equals": 0
            }
          }
        ],
        "pdp_approvals": [
          {
            "route": "submit",
            "count": {
              "equals": 1
            }
          }
        ]
      }
    },
    {
      "name": "The request in supersedes is consumed",
      "request": {
        "operation": "mcp_call_approval",
        "token": "person"
      },
      "expect": {
        "status": {
          "equals": 200
        },
        "json": {
          "/result/isError": {
            "equals": true
          },
          "/result/structuredContent/error/code": {
            "equals": "invalid_argument"
          },
          "/result/structuredContent/error/retryable": {
            "equals": false
          }
        },
        "pdp_questions": [
          {
            "json": {
              "/context/usage": {
                "present": true
              },
              "/context/approval/effect": {
                "present": true
              }
            },
            "count": {
              "equals": 0
            }
          }
        ],
        "pdp_approvals": [
          {
            "route": "submit",
            "count": {
              "equals": 1
            }
          }
        ]
      }
    }
  ]
}
