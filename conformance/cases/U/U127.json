{
  "id": "U127",
  "title": "A health-probe route needs no token and asks no question. A route with no action asks access on the service, with no usage.",
  "role": "pep",
  "paragraphs": [
    "10.0",
    "10.1c",
    "8.3"
  ],
  "requirement": "MUST",
  "notes": "A step whose operation the profile does not define is skipped. A service documents its health-probe routes (protocol 10.1c).",
  "given": {
    "tokens": {
      "person": {
        "subject": "alice"
      },
      "refused": {
        "subject": "bob"
      }
    },
    "pdp_script": [
      {
        "when": {
          "subject": "bob"
        },
        "respond": {
          "body": {
            "decision": false
          }
        }
      },
      {
        "when": {},
        "respond": {
          "body": {
            "decision": true
          }
        }
      }
    ]
  },
  "steps": [
    {
      "name": "A health probe with no token",
      "request": {
        "operation": "read_health"
      },
      "expect": {
        "status": {
          "regex": "^2[0-9]{2}$"
        },
        "pdp_questions": [
          {
            "json": {},
            "count": {
              "equals": 0
            }
          }
        ]
      }
    },
    {
      "name": "A route with no action",
      "request": {
        "operation": "use_no_action",
        "token": "person"
      },
      "expect": {
        "status": {
          "regex": "^2[0-9]{2}$"
        },
        "pdp_questions": [
          {
            "json": {
              "/action/name": {
                "equals": "access"
              },
              "/resource/type": {
                "equals": "service"
              },
              "/resource/id": {
                "equals": "{{service}}"
              },
              "/resource/properties/ancestors/0": {
                "absent": true
              },
              "/context/usage": {
                "absent": true
              },
              "/context/approval": {
                "absent": true
              }
            },
            "count": {
              "equals": 1
            }
          },
          {
            "json": {
              "/action/name": {
                "not_regex": "^access$"
              }
            },
            "count": {
              "equals": 0
            }
          }
        ]
      }
    },
    {
      "name": "A route with no action and no token",
      "request": {
        "operation": "use_no_action"
      },
      "expect": {
        "status": {
          "equals": 401
        },
        "pdp_questions": [
          {
            "json": {},
            "count": {
              "equals": 0
            }
          }
        ]
      }
    },
    {
      "name": "A route with no action and a refused subject",
      "request": {
        "operation": "use_no_action",
        "token": "refused"
      },
      "expect": {
        "status": {
          "equals": 403
        }
      }
    }
  ]
}
